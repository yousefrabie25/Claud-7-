# Site under test. Use staging for anything tagged @write.
BASE_URL=https://cloud7.io

# @write tests submit real forms (send leads + emails). Off by default.
WRITE_TESTS=false
# Second key, required only if WRITE_TESTS=true AND BASE_URL is production.
ALLOW_PROD_WRITES=false

# Skip tests tagged @known-defect (for a green deploy gate).
SKIP_KNOWN=false

# Home page time-to-first-byte budget in ms (API-001b).
TTFB_BUDGET_MS=800

# Staging must use Google reCAPTCHA v2 TEST keys (site key 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI).
# With them the checkbox always passes (UI write tests) and any token is accepted (API-008).
RECAPTCHA_TEST_TOKEN=

# Optional: Mailosaur, to read the demo-access email (UI-015).
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=
